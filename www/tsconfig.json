{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    // NodeNext compiles ../shared, a CommonJS package scope, to CommonJS in the Vercel Function, so its exports load
    // there; `verbatimModuleSyntax` would reject that.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": ["api", "src", "server", "vite.config.ts"]
}
