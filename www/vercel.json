{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "git": { "deploymentEnabled": { "**": false, "main": true } },
  "ignoreCommand": "test -n \"${VERCEL_GIT_PREVIOUS_SHA:-}\" && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ../shared ../assets/fonts || exit 1",
  "functions": {
    "api/demo.ts": { "maxDuration": 300, "includeFiles": "media/phone/**" }
  },
  "redirects": [{ "source": "/", "destination": "/demo", "permanent": false }],
  "rewrites": [
    { "source": "/demo/api/:path*", "destination": "/api/demo" },
    {
      "source": "/:page(privacy|terms|support|licenses)",
      "destination": "https://admired-goldfinch-660.convex.site/:page"
    }
  ]
}
