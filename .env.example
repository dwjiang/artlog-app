# Sentry source map and native debug symbol uploads; also set in EAS environments.
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Token Factory API key.
NEBIUS_API_KEY=your-nebius-api-key

# OpenAI text-to-speech API key (server-side only).
OPENAI_API_KEY=your-openai-api-key

# Private Cloudflare R2 bucket; set the same values on the Convex deployment.
# Scope the S3 credentials to Object Read & Write for this bucket. Never use EXPO_PUBLIC_.
R2_BUCKET=artlog-dev
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Tavily search and mapping.
TAVILY_API_KEY=tvly-your-api-key

# Python enrichment models; also configure these on Convex for cache misses.
FACT_SHEET_MODEL=your-fact-sheet-model-id
DOCENT_MODEL=your-docent-model-id

# Convex dev deployment slug written by `npx convex dev` (e.g. dev:wandering-fox-123)
CONVEX_DEPLOYMENT=dev:your-deployment
# Public Convex URL the Expo app connects to
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Convex HTTP actions URL (written by the CLI)
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# EXPO_PUBLIC_SENTRY_DSN is set only in the EAS production environment; adding it here makes dev builds report.
# Optional update-link override, such as itms-beta:// for TestFlight builds. Defaults to Artlog's App Store listing.
EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6815466893

# Google sign-in: public OAuth client IDs from the same Google Cloud project.
# iOS client must use bundle ID app.artlog.ios. Rebuild iOS after setting these.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client.apps.googleusercontent.com

# Python jobs: the same deployment as EXPO_PUBLIC_CONVEX_URL and a deploy key for it
# (`npx convex deployment token create artlog-jobs-local --save-env` writes the key here).
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=dev:your-deployment|replace-with-deploy-key
# Contact advertised in the polite fetcher's User-Agent (mailto:); optional but expected by museums.
CRAWLER_CONTACT=you@example.org
# Optional job settings: SCRATCH_DIR (default scripts/data/scratch), DEVICE (mps | cuda | cpu), LOG_LEVEL

# Server-side variables live on the Convex deployment: set with `npx convex env set`, never in
# this file. Names only:
#   SENTRY_DSN                                  backend error reporting; production deployment only
#   JWT_PRIVATE_KEY, JWKS, SITE_URL              Convex Auth (generated headlessly with jose)
#   APPLE_BUNDLE_ID                             app.artlog.ios (native Apple token audience)
#   APPLE_TEAM_ID, APPLE_KEY_ID,                 Sign in with Apple key that revokes Apple sign-in on account
#   APPLE_PRIVATE_KEY                             deletion (set the .p8 with `--from-file`)
#   GOOGLE_WEB_CLIENT_ID                        same as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
#   APP_ATTEST_REQUIRED, APP_ATTEST_APP_ID,      App Attest ("true" in production; TEAMID.bundleId;
#   APP_ATTEST_ALLOW_DEV                          accept Apple's development environment)
#   SUPPORTED_MODEL_VERSIONS                     embedding versions identify accepts
#   MINIMUM_IOS_BUILD                            oldest supported iOS build; unset disables the update requirement
#   FLAG_LABEL_FLOW, FLAG_RIGHT_NOW,             "on" / "off" kill switches
#   FLAG_EXHIBITION_REFRESH
#   DAILY_TOKEN_FACTORY_CALL_CAP,                global daily spend caps
#   DAILY_TAVILY_CREDIT_CAP
#   CRAWLER_CONTACT                             contact address for the collection probe User-Agent
#   NEBIUS_API_KEY, TAVILY_API_KEY              the same provider keys as above, for the label flow
#   OPENAI_API_KEY                             Shimmer narration and post moderation (required on the deployment)
#   LABEL_MODEL, MODERATION_MODEL,              Token Factory model IDs
#   FACT_SHEET_MODEL, DOCENT_MODEL              (nvidia/nemotron-3-super-120b-a12b, nvidia/Nemotron-3_5-Lightning,
#                                               nvidia/nemotron-3-super-120b-a12b, nvidia/Nemotron-3_5-Lightning)
#   MODERATION_BLOCKLIST                        optional comma-separated terms the moderation fallback flags

# Pinecone vector search; server-side only. Also configure the Convex deployment.
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_HOST=your-index-host.svc.us-east-1.pinecone.io

# Limrun cloud simulators for the judges demo; server-side only.
LIM_API_KEY=lim_your-limrun-api-key
# Optional judges-demo settings; see www/README.md.
# DEMO_ACCESS_CODE=your-access-code
# DEMO_APP_ASSET=artlog/judges-demo.app.tar.gz
# Set to 1 only in the judges demo build: it skips the welcome and Scan shows sample paintings instead of the camera.
# EXPO_PUBLIC_JUDGES_DEMO=1
