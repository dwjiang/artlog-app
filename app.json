{
  "expo": {
    "name": "artlog",
    "slug": "artlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "artlog",
    "userInterfaceStyle": "light",
    "ios": {
      "deploymentTarget": "17.0",
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.artlog.ios",
      "appleTeamId": "J4UW2CVVY4",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Artlog uses the camera to identify paintings and read wall labels.",
        "NSPhotoLibraryUsageDescription": "Artlog can identify paintings from photos you already took.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFBF6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Artlog can identify paintings from photos you already took.",
          "cameraPermission": "Artlog uses the camera to identify paintings and read wall labels.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Artlog uses your location to work out which museum you are in. Coordinates never leave your phone.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-sharing",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/anton-regular.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "04fdd022-7b1c-4e8e-85d7-50d6066a3751"
      }
    },
    "owner": "dwjiang"
  }
}
