{
  "expo": {
    "name": "artlog",
    "slug": "artlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "artlog",
    "userInterfaceStyle": "light",
    "ios": {
      "deploymentTarget": "17.0",
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.artlog.ios",
      "appleTeamId": "J4UW2CVVY4",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Artlog uses the camera to identify paintings and read wall labels.",
        "NSPhotoLibraryUsageDescription": "Artlog can identify paintings from photos you already took.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFCF9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Artlog can identify paintings from photos you already took.",
          "cameraPermission": "Artlog uses the camera to identify paintings and read wall labels.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Artlog can identify paintings from photos you already took.",
          "savePhotosPermission": "Artlog adds the full-size photos of artworks you save to your photo library."
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Artlog uses your location to find nearby museums.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-sharing",
      [
        "expo-font",
        {
          "ios": {
            "fonts": ["./assets/fonts/anton-regular.ttf"]
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "artlog-app",
          "organization": "daniel-jiang"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.artlog.ios.widgets",
          "groupIdentifier": "group.app.artlog.ios.widgets",
          "widgets": [
            {
              "name": "ArtlogWidget",
              "displayName": "Saved paintings",
              "description": "Bring your collection and past museum visits to your Home Screen.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ],
      "./plugins/with-artlog-widget",
      "expo-audio",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "04fdd022-7b1c-4e8e-85d7-50d6066a3751"
      }
    },
    "owner": "dwjiang"
  }
}
