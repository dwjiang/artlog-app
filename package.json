{
  "name": "artlog",
  "version": "1.0.0",
  "private": true,
  "license": "MPL-2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "preios": "npm run model:check",
    "lint": "oxlint --report-unused-disable-directives-severity=error && oxfmt --check",
    "format": "oxfmt",
    "test": "npm run test:app && npm run test:convex && npm run test:model && npm run test:licenses && npm run test:conductor && npm run test:exhibitions",
    "test:app": "jest",
    "test:convex": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "convex:codegen": "convex codegen",
    "codegen:vision": "cd modules/vision-rect && nitrogen",
    "model:check": "node --experimental-strip-types scripts/model/check-model.mts",
    "test:model": "node --experimental-strip-types --test scripts/model/*.test.mts",
    "licenses:generate": "node --experimental-strip-types scripts/licenses/generate.mts",
    "test:licenses": "node --experimental-strip-types --test scripts/licenses/*.test.mts",
    "test:conductor": "node --experimental-strip-types --test .conductor/*.test.mts",
    "test:exhibitions": "node --experimental-strip-types --test scripts/exhibitions/*.test.mts shared/exhibitions/*.test.mts",
    "exhibitions:extract": "node --experimental-strip-types scripts/exhibitions/extract.mts",
    "exhibitions:pilot": "node --experimental-strip-types scripts/exhibitions/pilot.mts",
    "exhibitions:import": "node --experimental-strip-types scripts/exhibitions/import.mts",
    "eas-build-pre-install": "npm run model:check"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@expo/app-integrity": "~58.0.2",
    "@expo/ui": "~58.0.23",
    "@photostructure/tz-lookup": "^11.6.1",
    "@react-native-community/slider": "5.2.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@sentry/core": "10.75.2",
    "@sentry/react-native": "~8.28.0",
    "@shopify/react-native-skia": "2.14.0",
    "cbor-x": "^1.6.6",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.124",
    "drizzle-orm": "^0.45.2",
    "expo": "~58.0.19",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.19",
    "expo-maps": "~58.0.10",
    "expo-media-library": "~58.0.12",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "expo-widgets": "~58.0.23",
    "jose": "^6.2.12",
    "moment-timezone": "^0.6.3",
    "node-app-attest": "^1.0.1",
    "obscenity": "^0.4.6",
    "parse5": "^7.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-sortables": "^1.10.0",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-worklets": "5.2.3",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.5.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "convex-test": "^0.0.56",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-expo": "^1.1.0",
    "expo-mcp": "~0.2.1",
    "image-size": "^2.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "nitrogen": "^0.37.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "robots-parser": "^3.0.1",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "jest": {
    "globalSetup": "<rootDir>/jest.global-setup.ts",
    "moduleNameMapper": {
      "^@/shared/(.*)$": "<rootDir>/shared/$1"
    },
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/shared",
      "<rootDir>/modules"
    ],
    "sandboxInjectedGlobals": [
      "Math"
    ],
    "setupFiles": [
      "react-native-gesture-handler/jestSetup",
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.mts$"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|standard-navigation|@sentry/.*|native-base|react-native-svg|@convex-dev/.*|is-network-error)"
    ]
  }
}
