{
  "name": "artlog",
  "version": "1.0.0",
  "private": true,
  "license": "MPL-2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "preios": "npm run model:check",
    "lint": "oxlint --report-unused-disable-directives-severity=error && oxfmt --check",
    "format": "oxfmt",
    "test": "npm run test:app && npm run test:convex && npm run test:model && npm run test:conductor && npm run test:sentry-automation",
    "test:app": "jest",
    "test:convex": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "convex:codegen": "convex codegen",
    "codegen:vision": "cd modules/vision-rect && nitrogen",
    "model:check": "node --experimental-strip-types scripts/model/check-model.mts",
    "test:model": "node --experimental-strip-types --test scripts/model/*.test.mts",
    "test:conductor": "node --experimental-strip-types --test .conductor/*.test.mts",
    "test:sentry-automation": "node --experimental-strip-types --test scripts/sentry-automation/*.test.ts",
    "eas-build-pre-install": "npm run model:check"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@expo/app-integrity": "~57.0.1",
    "@expo/ui": "~57.0.20",
    "@photostructure/tz-lookup": "^11.6.1",
    "@react-native-community/slider": "5.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@sentry/core": "10.37.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.6.2",
    "cbor-x": "^1.6.6",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.124",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.25",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.20",
    "jose": "^6.2.12",
    "moment-timezone": "^0.6.3",
    "node-app-attest": "^1.0.1",
    "obscenity": "^0.4.6",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fast-opencv": "^1.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sortables": "^1.10.0",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-worklets": "5.2.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "29.5.14",
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "convex-test": "^0.0.56",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-expo": "^1.1.0",
    "expo-mcp": "~0.2.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "nitrogen": "^0.37.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/shared/(.*)$": "<rootDir>/shared/$1"
    },
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/shared",
      "<rootDir>/modules"
    ],
    "sandboxInjectedGlobals": [
      "Math"
    ],
    "setupFiles": [
      "react-native-gesture-handler/jestSetup",
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|standard-navigation|@sentry/react-native|native-base|react-native-svg|@convex-dev/.*|is-network-error)"
    ]
  }
}
