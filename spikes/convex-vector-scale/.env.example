# Use an isolated dev deployment for artlog-spike-vectors, never the app deployment.
CONVEX_DEPLOYMENT=dev:your-spike-deployment
CONVEX_URL=https://your-spike-deployment.convex.cloud
CONVEX_SITE_URL=https://your-spike-deployment.convex.site
# Export this into the process environment; never commit the value.
CONVEX_DEPLOY_KEY=dev:your-spike-deployment|replace-with-deploy-key
