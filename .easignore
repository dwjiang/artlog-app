# .easignore replaces .gitignore for EAS uploads, so the git ignores are repeated here.
node_modules/
coverage/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
example
/ios
/android
spikes/**/artifacts/
spikes/**/.venv/
spikes/**/__pycache__/
spikes/**/.pytest_cache/

# Local model exports; the compiled model is fetched by eas-build-pre-install.
scripts/model/.venv/
scripts/model/cache/
scripts/model/out/
scripts/model/__pycache__/
scripts/model/.pytest_cache/
modules/coreml-embed/ios/Models/

# Not needed inside a build archive.
docs/
spikes/
.context/
*.test.*

# Metro resolves the calibration URL asset even in production builds.
jobs/*
!jobs/calibration
jobs/calibration/*
!jobs/calibration/urls.txt
