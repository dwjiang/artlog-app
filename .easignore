# .easignore replaces .gitignore for EAS uploads, so the git ignores are repeated here.
node_modules/
coverage/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
example
/ios
/android

# Local model exports; the tracked compiled model is included in the build archive.
scripts/model/.venv/
scripts/model/cache/
scripts/model/out/
scripts/model/__pycache__/
scripts/model/.pytest_cache/

# Not needed inside a build archive.
scripts/evals/
scripts/model/benchmark/
docs/
jobs/
.context/
*.test.*
