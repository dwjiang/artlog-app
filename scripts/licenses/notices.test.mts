import assert from "node:assert/strict";
import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { afterEach, beforeEach, test } from "node:test";

import {
  buildNotices,
  nearestPackageDir,
  npmNotice,
  packageDirsFromSources,
  parseAcknowledgements,
  parsePodfileLock,
  prebuiltNoticesForPod,
  reflow,
} from "./notices.mts";

let dir: string;

beforeEach(async () => {
  dir = await mkdtemp(join(tmpdir(), "artlog-notices-"));
});

afterEach(async () => {
  await rm(dir, { recursive: true, force: true });
});

await test("maps bundled source paths to their package directories", () => {
  const dirs = packageDirsFromSources(
    [
      "/node_modules/expo-router/build/index.js",
      "/node_modules/expo-router/build/link.js",
      "/node_modules/@sentry/core/build/esm/index.js",
      "/node_modules/metro/node_modules/metro-runtime/src/polyfills/require.js",
      "/Users/dev/app/node_modules/react/index.js",
      "/src/app/_layout.tsx",
      "__prelude__",
    ],
    "/Users/dev/app",
  );
  assert.deepEqual(dirs, [
    "/Users/dev/app/node_modules/@sentry/core",
    "/Users/dev/app/node_modules/expo-router",
    "/Users/dev/app/node_modules/metro/node_modules/metro-runtime",
    "/Users/dev/app/node_modules/react",
  ]);
});

await test("reads pod versions and local sources from a Podfile.lock", () => {
  const pods = parsePodfileLock(`PODS:
  - AppAuth (2.1.0):
    - AppAuth/Core (= 2.1.0)
  - AppAuth/Core (2.1.0)
  - ExpoImage (3.0.1):
    - ExpoModulesCore
  - hermes-engine (250829098.0.17):
    - hermes-engine/Pre-built (= 250829098.0.17)
  - Sentry/HybridSDK (8.58.0)

DEPENDENCIES:
  - AppAuth (= 2.1.0)
  - ExpoImage (from \`../node_modules/expo-image/ios/ExpoImage.podspec\`)

SPEC REPOS:
  trunk:
    - AppAuth
    - Sentry

EXTERNAL SOURCES:
  ExpoImage:
    :podspec: "../node_modules/expo-image/ios/ExpoImage.podspec"
  hermes-engine:
    :podspec: "../node_modules/react-native/sdks/hermes-engine/hermes-engine.podspec"
    :tag: hermes-2025-08-29-RNv0.86.0

SPEC CHECKSUMS:
  AppAuth: abc

PODFILE CHECKSUM: def

COCOAPODS: 1.16.2
`);
  assert.deepEqual(pods, [
    { name: "AppAuth", version: "2.1.0" },
    { name: "ExpoImage", version: "3.0.1", path: "../node_modules/expo-image/ios/ExpoImage.podspec" },
    {
      name: "hermes-engine",
      version: "250829098.0.17",
      path: "../node_modules/react-native/sdks/hermes-engine/hermes-engine.podspec",
    },
    { name: "Sentry", version: "8.58.0" },
  ]);
});

