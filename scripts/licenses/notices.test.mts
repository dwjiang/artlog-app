await test("reads a package's license file, preferring the plain LICENSE", async () => {
  await writeFile(join(dir, "package.json"), JSON.stringify({ name: "demo", version: "1.2.3", license: "MIT" }));
  await writeFile(join(dir, "LICENSE-MIT.txt"), "mit variant");
  await writeFile(join(dir, "LICENSE"), "Copyright demo");
  await mkdir(join(dir, "licenses"));
  assert.deepEqual(npmNotice(dir, {}), {
    name: "demo",
    version: "1.2.3",
    license: "MIT",
    source: "npm",
    text: "Copyright demo",
  });
});

await test("requires a verified, version-matched notice when a package ships no license file", async () => {
  await writeFile(
    join(dir, "package.json"),
    JSON.stringify({ name: "demo", version: "1.2.3", license: "MIT", author: "The maintainer" }),
  );
  const notice = {
    license: "MIT",
    text: "Copyright (c) 2009 The original author\nPermission is hereby granted.",
    url: "https://example.com/demo/1.2.3/LICENSE",
  };
  assert.deepEqual(npmNotice(dir, { "demo@1.2.3": notice }), {
    name: "demo",
    version: "1.2.3",
    source: "npm",
    ...notice,
  });
  assert.throws(() => npmNotice(dir, {}), /Add a verified notice/);
  assert.throws(() => npmNotice(dir, { "demo@1.2.2": notice }), /Add a verified notice/);
  assert.throws(() => npmNotice(dir, { "demo@1.2.3": { ...notice, license: "Apache-2.0" } }), /Add a verified notice/);
});

await test("includes bundled notices and requires a review when the native wrapper version changes", () => {
  const entry = { name: "NativeLibrary", version: "2.0.0", license: "BSD-3-Clause", text: "Copyright native author" };
  const bundles = { Wrapper: { version: "1.0.0", entries: [entry] } };
  assert.deepEqual(prebuiltNoticesForPod({ name: "Wrapper", version: "1.0.0" }, bundles), [
    { ...entry, source: "bundled" },
  ]);
  assert.throws(
    () => prebuiltNoticesForPod({ name: "Wrapper", version: "1.1.0" }, bundles),
    /Review the bundled notices/,
  );
  assert.deepEqual(prebuiltNoticesForPod({ name: "Unbundled", version: "1.0.0" }, bundles), []);
});

await test("finds the package that owns a native source path", async () => {
  await writeFile(join(dir, "package.json"), "{}");
  await mkdir(join(dir, "ios/Sub"), { recursive: true });
  assert.equal(nearestPackageDir(join(dir, "ios/Sub")), dir);
  assert.equal(nearestPackageDir(join(dir, "ios/Missing.podspec")), dir);
});

await test("reflows hard-wrapped lines while keeping paragraphs and list items", () => {
  assert.equal(
    reflow(
      "Copyright (c) 2014 Example and other\ncontributors\n\n   1. Redistributions of source code must retain the above\n      copyright notice.\n   2. Redistributions in binary form must reproduce the above\n      copyright notice.\n\n  (a) You must give any other recipients\n      a copy of this License; and\n  (b) You must cause\r\n",
    ),
    "Copyright (c) 2014 Example and other contributors\n\n1. Redistributions of source code must retain the above copyright notice.\n2. Redistributions in binary form must reproduce the above copyright notice.\n\n(a) You must give any other recipients a copy of this License; and\n(b) You must cause",
  );
});

await test("stores each distinct license text once, sorted by package name without duplicates", () => {
  const notices = buildNotices([
    { name: "zed", version: "1.0.0", license: "MIT", source: "npm", text: "Text A\r\n" },
    { name: "@scope/alpha", version: "2.0.0", license: "MIT", source: "npm", text: "Text A" },
    { name: "Beta", license: "BSD-3-Clause", source: "pod", text: "Text B\n" },
    { name: "zed", version: "1.0.0", license: "MIT", source: "npm", text: "Text A" },
  ]);
  assert.deepEqual(notices, {
    entries: [
      { name: "@scope/alpha", version: "2.0.0", license: "MIT", source: "npm", text: 0 },
      { name: "Beta", license: "BSD-3-Clause", source: "pod", text: 1 },
      { name: "zed", version: "1.0.0", license: "MIT", source: "npm", text: 0 },
    ],
    texts: ["Text A", "Text B"],
  });
});
